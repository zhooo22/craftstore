# Copy these into Railway → your service → Variables tab
# Generate JWT_SECRET with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

NODE_ENV=production
PORT=5000

JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_STRING
JWT_EXPIRES_IN=7d

DB_PATH=./db/craftstore.db

# Optional — leave blank to use console logging
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM=The Crafted Nest <noreply@craftednest.com>

# Set this to your Railway public URL after first deploy
# e.g. https://craftstore-production.up.railway.app
CLIENT_URL=https://YOUR_APP.up.railway.app
